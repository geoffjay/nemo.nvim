{
  "grammars": [
    {
      "name": "nemo",
      "camelcase": "Nemo",
      "scope": "source.nemo",
      "path": ".",
      "file-types": [
        "nemo"
      ],
      "injection-regex": "^nemo$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Nemo single-file components (.nemo SFC)",
    "links": {
      "repository": "https://github.com/geoffjay/nemo.nvim"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
